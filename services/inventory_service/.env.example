PORT=4001
RESERVATION_TTL_SECONDS=1800
# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=""
# Set by docker-compose.yml when running in Docker. For local runs, use the host ports:
REDIS_URL=redis://localhost:6379
RABBITMQ_URL="amqp://guest:guest@localhost:5673"
DATABASE_URL="postgresql://ticketuser:password@localhost:15433/ticketbooking"
# Refresh token lifetime (default 7 days). Access tokens always last 15 minutes.
REFRESH_TOKEN_TTL_SECONDS=604800
