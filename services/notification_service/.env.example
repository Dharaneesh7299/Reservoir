RESEND_API_KEY=""
# Sender address. Resend's shared onboarding address only delivers to your own account email;
# use an address on a domain you have verified in Resend to send to anyone.
EMAIL_FROM="Acme <onboarding@resend.dev>"
# Set by docker-compose.yml when running in Docker. For local runs, use the host port:
RABBITMQ_URL="amqp://guest:guest@localhost:5673"
